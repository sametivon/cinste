# Browser-safe values. These are intentionally public and may be embedded in
# the Next.js client bundle. Use a different Supabase project for local, QA,
# preview (if used), and production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only value. Keep this only in local .env.local or the Vercel server
# environment; never set it as NEXT_PUBLIC_*, copy it to mobile, or commit it.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret

# Public origins. Local development uses the values below. Vercel Production
# must use the canonical HTTPS web origin; previews must use their own origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Native student handoff. This must match the Expo scheme in apps/mobile/app.json
# and must never include a claim, QR, redemption, or other bearer credential.
NEXT_PUBLIC_STUDENT_APP_URL=cinste://

# Native Giver BFF. This public HTTPS callback must be allowlisted in Supabase
# Auth and associated as a verified Universal/App Link before device QA.
NEXT_PUBLIC_NATIVE_GIVER_CONFIRMATION_URL=https://qa.example.com/native/giver/confirm

# Server-only HMAC key for private database-backed BFF rate-limit fingerprints.
# Use at least 32 random bytes; never expose it to Expo, browser bundles, logs,
# or source control.
NATIVE_BFF_RATE_LIMIT_KEY=replace-with-server-only-random-secret
