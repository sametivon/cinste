# Expo embeds EXPO_PUBLIC_* values in the app bundle. Use only the production
# Supabase URL and publishable key selected for that build profile. Never add a
# service-role key, payment secret, or any other server-only value here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
